# ---------------------------------------------------------------------------
# Runtime / generated data
# ---------------------------------------------------------------------------
# SQLite scan databases (scan history is local-only)
*.db
*.sqlite
*.sqlite3
# Generated security reports (HTML) — rebuild anytime
reports/
# Local LLM explanation cache
.llm_cache.json
# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Environment files
# NOTE: the FAKE .env fixtures under targets/ ARE committed on purpose — they
# are deliberately vulnerable owned test targets (see targets/README.md).
# ---------------------------------------------------------------------------
.env
.env.*
!targets/.env
!targets/**/.env

# ---------------------------------------------------------------------------
# graphify knowledge graph (graphify-out/)
# Commit the portable outputs (graph.html, graph.json, GRAPH_REPORT.md,
# manifest.json) so the team shares the map. Ignore machine-specific,
# regenerable, and churn-prone files:
# ---------------------------------------------------------------------------
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
graphify-out/.graphify_*.json
# Per-file AST/semantic cache — rebuilt on demand; changes on every graph update
graphify-out/cache/
# Converted sidecars from PDFs/office docs, if any are ever processed
graphify-out/converted/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.claude/settings.local.json
.DS_Store
Thumbs.db
Desktop.ini